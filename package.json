{
  "name": "@katatan/csv4test",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepare": "npm run build:lib"
  },
  "devDependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "@playwright/test": "^1.63.0",
    "@types/encoding-japanese": "^2.4.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "encoding-japanese": "^2.4.0",
    "jsdom": "^25.0.1",
    "lodash": "^4.18.1",
    "marked": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-responsive-carousel": "^3.2.23",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./core": {
      "types": "./dist-lib/types/lib/core.d.ts",
      "import": "./dist-lib/core.js"
    }
  },
  "files": [
    "dist-lib"
  ]
}
